# استدعاء مفتاح التشفير من البيئة المحيطة (Security Layer)
ENCRYPTION_KEY = os.getenv("MASTER_KEY_12") 

def initialize_cipher():
    """توليد أو استرجاع مفتاح التشفير"""
    if not ENCRYPTION_KEY:
        # إذا لم يوجد مفتاح، يتم توليد واحد جديد (يجب حفظه في مكان آمن فوراً)
        key = Fernet.generate_key()
        print(f"[!] تحذير: لم يتم العثور على مفتاح. مفتاحك الجديد هو: {key.decode()}")
        return Fernet(key)
    return Fernet(ENCRYPTION_KEY.encode())

def encrypt_data(data):
    """تشفير المحتوى قبل الإرسال"""
    cipher = initialize_cipher()
    return cipher.encrypt(data.encode())

def decrypt_data(encrypted_data):
    """فك تشفير المحتوى المستلم"""
    cipher = initialize_cipher()
    try:
        return cipher.decrypt(encrypted_data).decode()
    except Exception:
        return "[X] فشل فك التشفير: المفتاح غير متطابق أو البيانات تالفة."

